{
  "name": "Shopi — Kenya's social marketplace",
  "short_name": "Shopi",
  "description": "Scroll a feed of real products from sellers near you, then message them directly. Free to use, no commission.",
  "id": "/en",
  "start_url": "/en",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait",
  "lang": "en-KE",
  "categories": ["shopping", "social", "business"],
  "background_color": "#d81470",
  "theme_color": "#d81470",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "shortcuts": [
    {
      "name": "Browse feed",
      "short_name": "Feed",
      "url": "/en/feed"
    },
    {
      "name": "Create a post",
      "short_name": "Post",
      "url": "/en/upload/create"
    },
    {
      "name": "Notifications",
      "short_name": "Alerts",
      "url": "/en/notifications"
    }
  ],
  "icons": [
    {
      "src": "/assets/shopi-logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/assets/shopi-logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/shopi-logo-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
